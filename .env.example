# DataHub - Environment configuration
# Copy to .env and adjust values.
# DataHub is a tiny "cloud + share link" service.
# It does NOT do AI cleaning itself - use it together with
# DataCleanerProAI (or any other tool) and let an AI assistant
# (Claude / ChatGPT / etc.) glue the two together.

# ---- Server ----
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ---- Storage ----
STORAGE_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
DEFAULT_EXPIRY_HOURS=72

# ---- Database ----
DB_PATH=./data/datahub.db

# ---- CORS ----
# Comma-separated allowed origins, * for any
CORS_ORIGIN=*

# ---- Rate limit ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300