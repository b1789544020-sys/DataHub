# DataHub - Environment configuration
# Copy to .env and adjust values.
# DataHub is a tiny "upload -> shareable short link" service.
# It does NOT do AI cleaning itself - pair it with DataCleanerProAI
# (or any other tool) and let an AI assistant glue the two together.

# ---- Server ----
PORT=3000
# Public base URL used to build share links (use your domain in production)
BASE_URL=http://localhost:3000
NODE_ENV=development

# ---- Auth ----
# REQUIRED in production: long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Storage ----
# Directory for uploaded files (relative paths resolve from project root)
STORAGE_DIR=./storage
# Per-file size limit (MB)
MAX_FILE_SIZE_MB=10
# Per-user total quota (MB)
MAX_USER_QUOTA_MB=100
# Share lifetime in days (applies to every upload)
LINK_EXPIRY_DAYS=7

# ---- Database ----
# SQLite file location (parent directory is created automatically)
DB_PATH=./storage/datahub.db

# ---- CORS ----
# Comma-separated allowed origins, * for any
CORS_ORIGIN=*

# ---- Rate limits ----
# Public share endpoints (/api/s/...): per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30